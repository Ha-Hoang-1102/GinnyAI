{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {"maxAttempts": 10, "windowMs": 60000, "lockoutMs": 300000, "exemptLoopback": false}
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["http://localhost:18789", "http://127.0.0.1:18789"]
    },
    "terminal": {"enabled": false},
    "nodes": {"pairing": {"autoApproveLocal": false, "sshVerify": false}}
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "userTimezone": "Asia/Bangkok",
      "systemAgent": {"agentId": "ginny"},
      "authInheritance": {"agentId": "ginny"},
      "heartbeat": {"every": "0m"},
      "maxConcurrent": 2,
      "subagents": {"maxConcurrent": 2, "maxChildrenPerAgent": 2, "runTimeoutSeconds": 300},
      "skills": []
    },
    "entries": {
      "ginny": {
        "name": "Ginny — Điều phối",
        "workspace": "/home/node/.openclaw/workspaces/ginny",
        "subagents": {"allowAgents": ["research", "editor", "media", "publisher", "analytics"]}
      },
      "research": {"name": "Nghiên cứu", "workspace": "/home/node/.openclaw/workspaces/research", "subagents": {"allowAgents": []}},
      "editor": {"name": "Biên tập", "workspace": "/home/node/.openclaw/workspaces/editor", "subagents": {"allowAgents": []}},
      "media": {"name": "Ảnh và video", "workspace": "/home/node/.openclaw/workspaces/media", "subagents": {"allowAgents": []}},
      "publisher": {"name": "Xuất bản", "workspace": "/home/node/.openclaw/workspaces/publisher", "subagents": {"allowAgents": []}},
      "analytics": {"name": "Phân tích", "workspace": "/home/node/.openclaw/workspaces/analytics", "subagents": {"allowAgents": []}}
    }
  },
  "session": {"dmScope": "per-channel-peer"},
  "browser": {"enabled": false},
  "memory": {"search": {"enabled": false}},
  "plugins": {"slots": {"memory": "none"}},
  "tools": {
    "allow": ["agents_list", "sessions_spawn", "sessions_list", "sessions_history", "session_status"],
    "sessions": {"visibility": "tree"},
    "agentToAgent": {"enabled": false},
    "exec": {"security": "deny", "ask": "always"},
    "elevated": {"enabled": false}
  },
  "channels": {
    "telegram": {"enabled": false, "dmPolicy": "pairing", "groupPolicy": "disabled", "configWrites": false},
    "discord": {"enabled": false}
  },
  "bindings": [{"agentId": "ginny", "match": {"channel": "telegram", "accountId": "default"}}],
  "cron": {"enabled": false}
}
